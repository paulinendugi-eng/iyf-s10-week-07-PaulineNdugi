const STORAGE_KEY = "todos";

export function saveTodos(todos) {

    localStorage.setItem(
        STORAGE_KEY,
        JSON.stringify(todos)
    );
}

export function loadTodos() {

    const data = localStorage.getItem(STORAGE_KEY);

    return data ? JSON.parse(data) : [];
}


